{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techmujin-orderpicker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orderpicker",
      // `npx wrangler d1 create orderpicker` で表示される ID に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
